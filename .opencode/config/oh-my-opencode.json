{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
  "agents": {

    "sisyphus": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "fallback_models": [
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"},
        {"model": "openai/gpt-5.4"}
      ],
      "description": "核心调度器: Claude Opus → opencode-go/kimi-k2.5 → K2P5 → GPT-5.4 → GLM-5 → Big Pickle"
    },
    "metis": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "fallback_models": [
        {"model": "bailian-coding-plan/glm-5"},
        {"model": "volcengine-plan/kimi-k2.5"},
        {"model": "openai/gpt-5.4"}
      ],
      "description": "计划缺陷分析器: Claude Opus → opencode-go/glm-5 → K2P5"
    },

    "prometheus": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "fallback_models": [
        {"model": "openai/gpt-5.4"},
        {"model": "bailian-coding-plan/glm-5"},
        {"model": "volcengine-plan/kimi-k2.5"},
        {"model": "google/antigravity-gemini-3-pro"}
      ],
      "description": "战略规划师: Claude Opus → GPT-5.4 → opencode-go/glm-5 → Gemini 3.1 Pro"
    },
    "atlas": {
      "model": "google/antigravity-claude-sonnet-4-6",
      "fallback_models": [
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"},
        {"model": "openai/gpt-5.4"}
      ],
      "description": "任务调度器: Claude Sonnet → opencode-go/kimi-k2.5"
    },

    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "description": "自主深度工作者: GPT-5.3 Codex only"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        {"model": "google/antigravity-gemini-3-pro"},
        {"model": "google/antigravity-claude-opus-4-5-thinking"},
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "架构顾问 (只读式高智商咨询): GPT-5.4 → Gemini 3.1 Pro → Claude Opus"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        {"model": "google/antigravity-claude-opus-4-5-thinking"},
        {"model": "google/antigravity-gemini-3-pro"},
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "严苛的评审者 (验证与计划评审): GPT-5.4 → Claude Opus → Gemini 3.1 Pro"
    },

    "explore": {
      "model": "bailian-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        {"model": "volcengine-plan/minimax-m2.5"}
      ],
      "description": "代码库快速检索 (速度就是一切, 并行启动 10 个任务): Grok Code Fast → opencode-go/minimax-m2.5 → MiniMax Free → Haiku → GPT-5-Nano"
    },
    "librarian": {
      "model": "bailian-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        {"model": "volcengine-plan/minimax-m2.5"}
      ],
      "description": "文档/代码搜索 (文档检索不需要深入推理): opencode-go/minimax-m2.5 → MiniMax Free → Haiku → GPT-5-Nano"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "视觉/截图 (使用第一个可用的、具备多模态能力的降级方案): GPT-5.4 → opencode-go/kimi-k2.5 → GLM-4.6v → GPT-5-Nano"
    }

  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3-pro",
      "fallback_models": [
        {"model": "bailian-coding-plan/glm-5"},
        {"model": "google/antigravity-claude-opus-4-5-thinking"},
        {"model": "volcengine-plan/kimi-k2.5"},
        {"model": "openai/gpt-5.4"}
      ],
      "description": "前端，UI，CSS，设计: Gemini 3.1 Pro → GLM 5 → Claude Opus"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        {"model": "google/antigravity-gemini-3-pro"},
        {"model": "google/antigravity-claude-opus-4-5-thinking"},
        {"model": "volcengine-plan/deepseek-v3.2"},
        {"model": "bailian-coding-plan/kimi-k2.5"}
      ],
      "description": "需要最大推理强度: GPT-5.4 → Gemini 3.1 Pro → Claude Opus"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "fallback_models": [
        {"model": "google/antigravity-claude-opus-4-5-thinking"},
        {"model": "google/antigravity-gemini-3-pro"},
        {"model": "volcengine-plan/ark-code-latest"},
        {"model": "bailian-coding-plan/kimi-k2.5"}
      ],
      "description": "深度编码，复杂逻辑处理: GPT-5.3 Codex → Claude Opus → Gemini 3.1 Pro"
    },

    "artistry": {
      "model": "google/antigravity-gemini-3-pro",
      "fallback_models": [
        {"model": "google/antigravity-claude-opus-4-5-thinking"},
        {"model": "openai/gpt-5.4"},
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "富有创意、新颖的方法: Gemini 3.1 Pro → Claude Opus → GPT-5.4"
    },
    "quick": {
      "model": "bailian-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        {"model": "volcengine-plan/minimax-m2.5"}
      ],
      "description": "简单、快速的任务: Claude Haiku → Gemini Flash → GPT-5-Nano"
    },

    "unspecified-high": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "fallback_models": [
        {"model": "openai/gpt-5.4 (high)"},
        {"model": "bailian-coding-plan/glm-5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "一般复杂工作: Claude Opus → GPT-5.4 (high) → GLM 5 → K2P5"
    },
    "unspecified-low": {
      "model": "google/antigravity-claude-sonnet-4-6",
      "fallback_models": [
        {"model": "openai/gpt-5.3-codex"},
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "一般标准工作: Claude Sonnet → GPT-5.3 Codex → Gemini Flash"
    },
    "writing": {
      "model": "google/antigravity-gemini-3-flash",
      "fallback_models": [
        {"model": "google/antigravity-claude-sonnet-4-6"},
        {"model": "openai/gpt-5.4"},
        {"model": "bailian-coding-plan/kimi-k2.5"},
        {"model": "volcengine-plan/kimi-k2.5"}
      ],
      "description": "文本、文档、散文: Gemini Flash → Claude Sonnet"
    }
  }
}
