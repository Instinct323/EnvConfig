{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  "agents": {
    "sisyphus": {
      "model": "google/antigravity-claude-opus-4-6-thinking",
      "fallback_models": [
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5",
        "openai/gpt-5.4"
      ],
      "description": "核心调度器"
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "description": "自主深度工作者"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "google/antigravity-gemini-3-pro",
        "google/antigravity-claude-opus-4-6-thinking",
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "架构顾问 (只读式高智商咨询)"
    },

    "librarian": {
      "model": "bailian-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        "baiduqianfancodingplan/minimax-m2.5",
        "volcengine-plan/minimax-m2.5",
        "opencode/minimax-m2.5-free"
      ],
      "description": "文档/代码搜索 (文档检索不需要深入推理)"
    },
    "explore": {
      "model": "bailian-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        "baiduqianfancodingplan/minimax-m2.5",
        "volcengine-plan/minimax-m2.5",
        "opencode/minimax-m2.5-free"
      ],
      "description": "代码库快速检索 (速度就是一切, 并行启动 10 个任务)"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "视觉/截图 (使用第一个可用的、具备多模态能力的降级方案)"
    },

    "prometheus": {
      "model": "google/antigravity-claude-opus-4-6-thinking",
      "fallback_models": [
        "openai/gpt-5.4",
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "战略规划师"
    },
    "metis": {
      "model": "google/antigravity-claude-opus-4-6-thinking",
      "fallback_models": [
        "openai/gpt-5.4",
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "计划缺陷分析器"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "google/antigravity-claude-opus-4-6-thinking",
        "google/antigravity-gemini-3-pro",
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "严苛的评审者 (验证与计划评审)"
    },

    "atlas": {
      "model": "google/antigravity-claude-sonnet-4-6",
      "fallback_models": [
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5",
        "openai/gpt-5.4"
      ],
      "description": "任务调度器"
    },
    "sisyphus-junior": {
      "model": "google/antigravity-claude-sonnet-4-6",
      "fallback_models": [
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5",
        "openai/gpt-5.4"
      ],
      "description": "类目执行器"
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback_models": [
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5",
        "google/antigravity-claude-opus-4-6-thinking",
        "openai/gpt-5.4",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "前端，UI，CSS，设计"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "google/antigravity-gemini-3.1-pro",
        "google/antigravity-claude-opus-4-6-thinking",
        "volcengine-plan/deepseek-v3.2",
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5"
      ],
      "description": "需要最大推理强度"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "fallback_models": [
        "google/antigravity-claude-opus-4-6-thinking",
        "google/antigravity-gemini-3.1-pro",
        "volcengine-plan/doubao-seed-2.0-code",
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5"
      ],
      "description": "深度编码，复杂逻辑处理"
    },

    "artistry": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback_models": [
        "google/antigravity-claude-opus-4-6-thinking",
        "openai/gpt-5.4",
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "富有创意、新颖的方法"
    },
    "quick": {
      "model": "bailian-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        "baiduqianfancodingplan/minimax-m2.5",
        "volcengine-plan/minimax-m2.5",
        "opencode/minimax-m2.5-free"
      ],
      "description": "简单、快速的任务"
    },

    "unspecified-low": {
      "model": "google/antigravity-claude-sonnet-4-6",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "一般标准工作"
    },
    "unspecified-high": {
      "model": "google/antigravity-claude-opus-4-6-thinking",
      "fallback_models": [
        "openai/gpt-5.4",
        "bailian-coding-plan/glm-5",
        "baiduqianfancodingplan/glm-5",
        "volcengine-plan/kimi-k2.5"
      ],
      "description": "一般复杂工作"
    },
    "writing": {
      "model": "google/antigravity-gemini-3-flash",
      "fallback_models": [
        "bailian-coding-plan/kimi-k2.5",
        "baiduqianfancodingplan/kimi-k2.5",
        "volcengine-plan/kimi-k2.5",
        "google/antigravity-claude-sonnet-4-6",
        "openai/gpt-5.4"
      ],
      "description": "文本、文档、散文"
    }
  }
}
